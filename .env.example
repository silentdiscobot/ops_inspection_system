# 可选配置：不创建 .env 也能直接启动。
# 生产环境建议覆盖默认管理员密码；Session 密钥留空时由容器自动生成并持久化。
OPS_SECRET_KEY=
OPS_ADMIN_PASSWORD=

OPS_BIND_ADDRESS=0.0.0.0
OPS_PUBLISHED_PORT=1999
# 简易部署默认关闭；高安全环境准备 known_hosts 后改为 1。
OPS_SSH_STRICT_HOST_KEY=0
OPS_QUEUE_WORKERS=2
OPS_QUEUE_RETRY_DELAY=10
OPS_SERVER_HEALTH_INTERVAL=600
OPS_CPU_THRESHOLD=80
OPS_MEM_THRESHOLD=80
OPS_DISK_THRESHOLD=80
OPS_CONTAINER_CPUS=2.0
OPS_CONTAINER_MEMORY=1g
